{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/netdiag-cli",
  "version": "0.5.22",
  "description": "The command line of netdiag: one command takes a target and gives the probable causes of a fault and the next step.",
  "keywords": [
    "network",
    "diagnosis",
    "cli",
    "dns",
    "tls",
    "http",
    "ping"
  ],
  "homepage": "https://github.com/mark1russell7/netdiag#readme",
  "bugs": {
    "url": "https://github.com/mark1russell7/netdiag/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/netdiag.git",
    "directory": "packages/netdiag-cli"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "netdiag": "./src/bin.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./report": "./src/report.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "bin": {
      "netdiag": "./build/bin.js"
    },
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./report": {
        "types": "./build/report.d.ts",
        "default": "./build/report.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@netdiag/fixtures": "workspace:*",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^4.10.2",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@mark1russell7/algebra": "^0.8.10",
    "@mark1russell7/netdiag": "workspace:*",
    "@mark1russell7/optional": "^1.2.0",
    "@mark1russell7/text": "^0.0.6",
    "@procedures/cli-kit": "^0.57.0",
    "@procedures/client": "^0.57.0",
    "@procedures/shell": "^0.57.0",
    "polite-crawler": "^0.7.6",
    "zod": "^4.6.7"
  }
}
