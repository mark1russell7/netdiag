{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/netdiag",
  "version": "0.8.3",
  "description": "Network diagnosis: typed facts at each layer of the stack, probes as adapters, and a scope rule for active probes.",
  "keywords": [
    "network",
    "diagnosis",
    "dns",
    "tcp",
    "tls",
    "http",
    "probe",
    "typescript"
  ],
  "homepage": "https://github.com/metrograph-labs/netdiag#readme",
  "bugs": {
    "url": "https://github.com/metrograph-labs/netdiag/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metrograph-labs/netdiag.git",
    "directory": "packages/netdiag"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core.ts",
    "./address": "./src/address/index.ts",
    "./diagnosis": "./src/diagnosis/index.ts",
    "./tools": "./src/tools/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./core": {
        "types": "./build/core.d.ts",
        "default": "./build/core.js"
      },
      "./address": {
        "types": "./build/address.d.ts",
        "default": "./build/address.js"
      },
      "./diagnosis": {
        "types": "./build/diagnosis.d.ts",
        "default": "./build/diagnosis.js"
      },
      "./tools": {
        "types": "./build/tools.d.ts",
        "default": "./build/tools.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/algebra": "^0.8.8",
    "@mark1russell7/optional": "^1.2.0",
    "@mark1russell7/rigor-statistics": "^0.2.3",
    "@mark1russell7/text": "^0.0.6"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@mark1russell7/rigor-chaos": "^0.2.2",
    "@mark1russell7/rigor-proxy": "^0.2.1",
    "@mark1russell7/rigor-testkit": "^0.1.8",
    "@netdiag/fixtures": "workspace:*",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^4.10.2",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
